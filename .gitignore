node_modules
dist
.env
.DS_Store
.env.local
.env.*.local
.env.spike
scripts/.last-publish-summary.json
scripts/.vintage-candidates.json
scripts/.vintage-candidates.md
scripts/.audit-findings.md
scripts/.Rhistory
scripts/_tmp-*

# Playwright artifacts
test-results/
playwright-report/
playwright/.cache/

# iOS native (Sprint #86 — Capacitor Phase 1)
# Pods/ is regenerated on every `pod install`; Podfile + Podfile.lock are the
# source of truth for native dependencies. xcuser* is per-developer Xcode
# state (window layouts, breakpoints) that shouldn't follow the project.
ios/App/Pods/
ios/App/build/
ios/build/
ios/DerivedData/
**/*.xcuserdata/
**/*.xcuserstate

# Signing keys — NEVER commit (Android keystore / Apple keys)
*.jks
*.keystore
*.p8
*.p12
key.properties

# Raw pg_dump lands here UNSCRUBBED (contains the service_role JWT inside the
# send_push trigger definition). Claude scrubs it into pg_dump-baseline.sql;
# the raw file must never be committable.
supabase/prod-snapshot/pg_dump-baseline.raw.sql
android/.idea/deploymentTargetSelector.xml
android/.idea/runConfigurations.xml
.shots/
.cache/

# Cutout PNGs are HOSTED IN THE SUPABASE BUCKET (player-cutouts), never in git:
# 895 files / ~380MB that would bake into history and churn on every re-cut.
# The manifest + provenance ledger stay tracked — they are data, not assets.
public/lineup/cutouts/*.png

# VAPID private key — generated locally, never committed (scripts/gen-vapid-keys.mjs)
.vapid-keys.local.json
android/app/google-services.json

# screenshot generator scratch — frame-store-screens.mjs writes this every run.
# It was tracked, so each regeneration committed another 2.4MB blob.
.tmp.html

# background-task worktrees can be created inside subdirs; never commit or lint them
**/.claude/worktrees/

# PL cutout wave staging — survives /tmp wipes; published only after the eyeball pass
.wave-staging/

# Lineup Builder photo cutouts (parked PL wave): 1.7 GB of local PNGs. Lived in public/ until the 1.7.3 cut,
# where Vite copied them into dist and cap sync shipped a 1.9 GB Android bundle.
assets/lineup-cutouts/
