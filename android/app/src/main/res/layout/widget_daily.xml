<?xml version="1.0" encoding="utf-8"?>
<!-- Dark card matching the app canvas (#0A0A0A). Static dark design on
     purpose: the app itself is dark-only, and a widget that matches the
     brand beats one that chases the launcher theme. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/widget_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#FFC107"
        android:text="🔥 —" />

    <TextView
        android:id="@+id/widget_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#8AE042"
        android:text="0/4" />

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="11sp"
        android:textColor="#9BA0B8"
        android:gravity="center"
        android:maxLines="2"
        android:text="Play today's puzzles" />
</LinearLayout>
