<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Capacitor 8's SystemBars paints the strips behind the status bar and the
             navigation bar with the window background whenever it pads the WebView
             (WebView older than 140, or a page without viewport-fit=cover). The
             DayNight default is white in light mode, which gave a dark app two white
             bars with unreadable icons (Android 16 emulator, WebView 133, 15 Nov 2026,
             on the first Capacitor 8 branch; the same fix, carried over on 24 Nov).
             The app is dark in both modes, so the window is too. -->
        <item name="android:windowBackground">@color/appBackground</item>
    </style>


    <!-- The launch screen is the app's own dark, not the system's default.
         Without windowSplashScreenBackground, Android 12 and later drew the
         icon on a near-white screen for a moment before a dark app (seen on
         an Android 16 emulator, 13 Oct 2026). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">#0B0C10</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>